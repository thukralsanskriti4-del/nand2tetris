CHIP ALU {
    IN
        x[16], y[16],
        zx, nx,
        zy, ny,
        f, no;

    OUT
        out[16],
        zr,
        ng;

    PARTS:

    // Zero x
    Mux16(a=x, b=false, sel=zx, out=x1);

    // Negate x
    Not16(in=x1, out=notx);
    Mux16(a=x1, b=notx, sel=nx, out=x2);

    // Zero y
    Mux16(a=y, b=false, sel=zy, out=y1);

    // Negate y
    Not16(in=y1, out=noty);
    Mux16(a=y1, b=noty, sel=ny, out=y2);

    // Function: x+y OR x&y
    And16(a=x2, b=y2, out=andxy);
    Add16(a=x2, b=y2, out=addxy);
    Mux16(a=andxy, b=addxy, sel=f, out=result);

    // Negate output
    Not16(in=result, out=notresult);
    Mux16(a=result, b=notresult, sel=no, out=out);

    // zr = 1 if output is zero
    Or8Way(in=out[0..7], out=orlow);
    Or8Way(in=out[8..15], out=orhigh);
    Or(a=orlow, b=orhigh, out=anyout);
    Not(in=anyout, out=zr);

    // ng = most significant bit
    And(a=out[15], b=true, out=ng);
}